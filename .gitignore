# PAYO .gitignore

# ===============================
# Dependencies
# ===============================
node_modules/
__pycache__/
*.pyc
.Python
env/
venv/
.venv/

# ===============================
# Build outputs
# ===============================
dist/
build/
*.egg-info/
.expo/
web-build/

# ===============================
# IDE & Editors
# ===============================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===============================
# Environment & Secrets
# ===============================
.env
.env.local
.env.*.local
*.pem
*.key

# ===============================
# Logs
# ===============================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===============================
# Testing
# ===============================
coverage/
.coverage
htmlcov/
.pytest_cache/
.nyc_output/

# ===============================
# AI Models (large files)
# ===============================
*.onnx
*.bin
*.safetensors
on-device-ai/.cache/
on-device-ai/models/stt/*.onnx
on-device-ai/models/stt/*.bin

# ===============================
# Temporary files
# ===============================
*.tmp
*.temp
.cache/
tmp/
temp/

# ===============================
# OS generated
# ===============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ===============================
# Project specific
# ===============================
test_reports/
memory/
*.db
*.sqlite
