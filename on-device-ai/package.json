{
  "name": "payo-on-device-ai",
  "version": "1.0.0",
  "description": "PAYO On-Device AI Engine - STT & QR Processing (100% Offline)",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node tests/test-all.js",
    "test:stt": "node tests/test-stt.js",
    "test:qr": "node tests/test-qr.js",
    "download-models": "node scripts/download-models.js",
    "setup": "npm install && npm run download-models",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.0",
    "onnxruntime-node": "^1.18.0",
    "qrcode": "^1.5.4",
    "jsqr": "^1.4.0",
    "jimp": "^0.22.12",
    "wav": "^1.0.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "keywords": [
    "payo",
    "pos",
    "on-device-ai",
    "offline",
    "stt",
    "speech-to-text",
    "whisper",
